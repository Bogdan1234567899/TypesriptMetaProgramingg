<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Codegen.cs має top-level statements і є entry point.
         Generated*.cs — артефакт виходу, не компілюється сюди. -->
    <Compile Remove="GeneratedWarehouseRuntime.cs" />
    <None Include="GeneratedWarehouseRuntime.cs" />
    <None Update="*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
